# Vyomel environment configuration
# Copy to .env and fill in. NEVER commit .env.
# All variables are prefixed VYOMEL_ and map onto vyomel.core.config.Settings.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
VYOMEL_ENV=dev                      # dev | test | prod
VYOMEL_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
VYOMEL_LOG_FORMAT=console           # console | json

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
VYOMEL_API_HOST=127.0.0.1           # loopback only by default -- do not expose
VYOMEL_API_PORT=8080
VYOMEL_API_TOKEN=change-me-to-a-random-string

# ---------------------------------------------------------------------------
# Datastores  (ports are non-default on purpose -- see docs/13-ENVIRONMENT.md)
# ---------------------------------------------------------------------------
VYOMEL_DATABASE_URL=postgresql+asyncpg://vyomel:vyomel@localhost:55432/vyomel
VYOMEL_REDIS_URL=redis://localhost:56379/0

# ---------------------------------------------------------------------------
# Filesystem sandbox  (semicolon-separated allowlist of roots tools may touch)
# ---------------------------------------------------------------------------
VYOMEL_WORKSPACE_ROOT=D:/Vyomel/.vyomel
VYOMEL_ALLOWED_ROOTS=D:/Vyomel;D:/Vyomel/.vyomel/scratch

# ---------------------------------------------------------------------------
# Bounds  (hard ceilings are enforced in code and cannot be raised from here)
# ---------------------------------------------------------------------------
VYOMEL_MAX_RETRIES=2
VYOMEL_MAX_REPLANS=3
VYOMEL_MAX_STEPS=40
VYOMEL_MAX_PARALLEL_ACTIONS=4
VYOMEL_ACTION_TIMEOUT_S=120
VYOMEL_MAX_WALL_CLOCK_S=3600
VYOMEL_MAX_TOKEN_BUDGET=200000
VYOMEL_MAX_COST_USD=2.00
VYOMEL_APPROVAL_TTL_S=3600

# ---------------------------------------------------------------------------
# Model providers  (leave blank to disable a provider)
# ---------------------------------------------------------------------------
VYOMEL_OPENAI_API_KEY=
VYOMEL_ANTHROPIC_API_KEY=
VYOMEL_LOCAL_MODEL_BASE_URL=http://localhost:11434/v1
VYOMEL_VLLM_BASE_URL=
VYOMEL_VLLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
VYOMEL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VYOMEL_EMBEDDING_BACKEND=auto          # auto | hashing | bge (tests force hashing)
VYOMEL_PLANNER_BACKEND=auto            # auto | mock | mock-alt | openai | local | vllm
VYOMEL_OFFLINE=false                # true => local providers only, no network
VYOMEL_VLLM_BASE_URL=               # OpenAI-compatible base, e.g. http://localhost:8000/v1
VYOMEL_VLLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# ---------------------------------------------------------------------------
# Kubernetes / process topology (M13)
# ---------------------------------------------------------------------------
VYOMEL_EMBED_SCHEDULER=true         # false in cluster — run `vyomel scheduler` separately
VYOMEL_SCHEDULER_LOCK_KEY=vyomel:scheduler:leader
VYOMEL_SCHEDULER_LOCK_TTL_S=15
VYOMEL_DISABLE_HOST_TOOLS=false     # true on in-cluster workers (desktop stays on local agent)
VYOMEL_LOCAL_AGENT_TOKEN=           # shared secret for `vyomel agent` WebSocket
VYOMEL_LOCAL_AGENT_ROUTING=true     # route desktop.* to a connected local agent

# ---------------------------------------------------------------------------
# Media (M14)
# ---------------------------------------------------------------------------
VYOMEL_MEDIA_BACKEND=auto           # auto | fixture | ffmpeg
VYOMEL_MEDIA_FIXTURES_DIR=vyomel/tools/media/fixtures

# ---------------------------------------------------------------------------
# Voice (M16)
# ---------------------------------------------------------------------------
VYOMEL_VOICE_BACKEND=auto           # auto | fixture | whisper
VYOMEL_VOICE_WAKE_PHRASE=hey vyomel

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
VYOMEL_OTEL_ENABLED=false
VYOMEL_OTEL_ENDPOINT=http://localhost:4317
VYOMEL_METRICS_ENABLED=true
