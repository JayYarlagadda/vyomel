# Astra environment configuration
# Copy to .env and fill in. NEVER commit .env.
# All variables are prefixed ASTRA_ and map onto astra.core.config.Settings.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
ASTRA_ENV=dev                      # dev | test | prod
ASTRA_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
ASTRA_LOG_FORMAT=console           # console | json

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
ASTRA_API_HOST=127.0.0.1           # loopback only by default -- do not expose
ASTRA_API_PORT=8080
ASTRA_API_TOKEN=change-me-to-a-random-string

# ---------------------------------------------------------------------------
# Datastores  (ports are non-default on purpose -- see docs/13-ENVIRONMENT.md)
# ---------------------------------------------------------------------------
ASTRA_DATABASE_URL=postgresql+asyncpg://astra:astra@localhost:55432/astra
ASTRA_REDIS_URL=redis://localhost:56379/0

# ---------------------------------------------------------------------------
# Filesystem sandbox  (semicolon-separated allowlist of roots tools may touch)
# ---------------------------------------------------------------------------
ASTRA_WORKSPACE_ROOT=D:/Astra/.astra
ASTRA_ALLOWED_ROOTS=D:/Astra;D:/Astra/.astra/scratch

# ---------------------------------------------------------------------------
# Bounds  (hard ceilings are enforced in code and cannot be raised from here)
# ---------------------------------------------------------------------------
ASTRA_MAX_RETRIES=2
ASTRA_MAX_REPLANS=3
ASTRA_MAX_STEPS=40
ASTRA_MAX_PARALLEL_ACTIONS=4
ASTRA_ACTION_TIMEOUT_S=120
ASTRA_MAX_WALL_CLOCK_S=3600
ASTRA_MAX_TOKEN_BUDGET=200000
ASTRA_MAX_COST_USD=2.00
ASTRA_APPROVAL_TTL_S=3600

# ---------------------------------------------------------------------------
# Model providers  (leave blank to disable a provider)
# ---------------------------------------------------------------------------
ASTRA_OPENAI_API_KEY=
ASTRA_ANTHROPIC_API_KEY=
ASTRA_LOCAL_MODEL_BASE_URL=http://localhost:11434/v1
ASTRA_VLLM_BASE_URL=
ASTRA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
ASTRA_EMBEDDING_BACKEND=auto          # auto | hashing | bge (tests force hashing)
ASTRA_PLANNER_BACKEND=auto            # auto | mock | mock-alt | openai | local
ASTRA_OFFLINE=false                # true => local providers only, no network

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
ASTRA_OTEL_ENABLED=false
ASTRA_OTEL_ENDPOINT=http://localhost:4317
ASTRA_METRICS_ENABLED=true
